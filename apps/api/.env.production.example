# Production env for the API (Railway). Set these in the Railway service
# (service → Variables), NOT a committed file. NODE_ENV=production makes the auth
# fail-safe active, so AUTH_DEV_BYPASS MUST be 0 (the app refuses to boot otherwise).

NODE_ENV=production
# Railway injects PORT; the app reads it. Leave unset or let Railway set it.
# PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# Currently Neon (ap-southeast-1) as an interim. Target: Railway Postgres (Hobby
# plan). After adding the Postgres service, reference it instead of pasting:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Move the data first (pg_dump from Neon → pg_restore into Railway), then swap.
# Add ?connection_limit=… if pooling.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Auth ─────────────────────────────────────────────────────────────────────
# Real auth only in prod — no x-dev-uid.
AUTH_DEV_BYPASS=0

# Firebase Admin — paste the service-account JSON as ONE env var (no file needed).
# Firebase console → Project settings → Service accounts → Generate new private key.
# Phone-OTP SMS additionally needs the project on the Blaze (pay-as-you-go) plan
# and the Phone provider enabled — no env var for that, it's console-side.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"wash-and-go-28cce", "...": "..."}

# ── Maps ─────────────────────────────────────────────────────────────────────
# Only "tomtom" is implemented. The key needs Search API + Routing API enabled.
# Server-side key: restrict it by IP / keep it off every client bundle.
MAPS_PROVIDER=tomtom
TOMTOM_API_KEY=your-tomtom-key
# NOT READ YET (no Google adapter). Reserved for the TomTom-vs-Google benchmark.
# GOOGLE_MAPS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allow-list of deployed web origins, comma-separated, exact scheme+host, NO
# trailing slash. Required in prod (unset = no cross-origin). Add each Vercel
# domain (add the laundry portal once it's deployed).
CORS_ORIGINS=https://wash-and-go-admin.vercel.app,https://<laundry-portal>.vercel.app

# ── Error tracking (Sentry) ──────────────────────────────────────────────────
# Optional. DSN from the Sentry Node project → 5xx reporting. Unset = disabled.
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzz
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=

# ── File uploads (Cloudflare R2) ─────────────────────────────────────────────
# Private bucket for onboarding proof (shop permits, rider IDs). Optional;
# unset = uploads disabled (503). All four must be set. Token: R2 → Manage API
# Tokens → Object Read & Write, scoped to the bucket. Bucket CORS must allow
# PUT + GET from the portal/app origins.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=…
# R2_SECRET_ACCESS_KEY=…
# R2_BUCKET=washgo-uploads

# Redis (only when Phase D realtime/jobs lands).
# REDIS_URL=redis://…
