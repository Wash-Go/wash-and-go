# development | test | production. Required. In production, AUTH_DEV_BYPASS must
# be 0 — the app refuses to boot with the bypass on outside development/test.
NODE_ENV=development
DATABASE_URL="postgresql://dev:dev@localhost:5433/wash_and_go"
REDIS_URL="redis://localhost:6380"
# Firebase Admin SDK — path to service account JSON (never commit the JSON itself)
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"
PORT=4000
# Dev-only auth shim: trust x-dev-uid instead of a real Firebase token. MUST be 0
# in production/staging (fail-safe refuses boot otherwise).
AUTH_DEV_BYPASS=0
# CORS allow-list, comma-separated. Unset in prod = no cross-origin; unset in dev
# reflects the request origin.
# CORS_ORIGINS="https://admin.washandgo.app,https://portal.washandgo.app"

# ── Maps provider (geocoding + driving distance) ──────────────────────────────
# Which adapter the backend uses. Only "tomtom" is implemented; anything else (or
# no key) falls back to keyless haversine distance with NO geocoding/search.
MAPS_PROVIDER=tomtom
# TomTom Developer key — server-side, never shipped to a client.
# Get one: https://developer.tomtom.com → Dashboard → Keys. Free tier ~2,500 req/day.
# Enable these products on the key: Search API (geocode + admin address typeahead
# + reverse geocode) and Routing API (driving distance). A key that is set but
# rejected (401/403) degrades silently: search returns nothing, reverse falls
# back to OSM Nominatim.
TOMTOM_API_KEY=""
# Google Maps Platform key — NOT READ YET (no Google adapter exists). Reserved for
# the TomTom-vs-Google benchmark; leave empty until that adapter lands.
GOOGLE_MAPS_API_KEY=""

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Optional. Unset = disabled (ships inert). Create a free-tier Node project at
# sentry.io and paste its DSN to switch on 5xx error reporting.
SENTRY_DSN=""
# Defaults to NODE_ENV. Set to distinguish staging vs prod in the Sentry UI.
# SENTRY_ENVIRONMENT=production
# Perf tracing sample rate 0–1 (default 0 = errors only; keeps the free quota).
# SENTRY_TRACES_SAMPLE_RATE=0
# Optional release tag for grouping (e.g. the git SHA).
# SENTRY_RELEASE=

# ── File uploads (Cloudflare R2) ──────────────────────────────────────────────
# Optional. Unset = uploads disabled (endpoints 503). Private bucket for
# onboarding proof (shop permits, rider IDs). S3-compatible; region is "auto".
# All four of ENDPOINT / ACCESS_KEY_ID / SECRET_ACCESS_KEY / BUCKET must be set.
# Setup: Cloudflare dash → R2 → create bucket (keep it PRIVATE) → "Manage R2 API
# Tokens" → Object Read & Write, scoped to this bucket → copy the key pair.
# Bucket → Settings → CORS: allow PUT + GET from the web/app origins, or the
# browser's direct presigned upload is blocked.
# The account id appears only inside the endpoint URL (the code doesn't read
# R2_ACCOUNT_ID on its own).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=washgo-uploads
