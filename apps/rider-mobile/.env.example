# Rider app (Expo/React Native). Only EXPO_PUBLIC_* vars are exposed to the app
# bundle — nothing secret. Firebase web config is committed (public).

# API base URL the app calls. REQUIRED in a production build.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Dev-only auth stub (x-dev-uid, needs API AUTH_DEV_BYPASS=1). Defaults to
# "dev-rider" in __DEV__. MUST be unset in a production build (real Firebase
# login required).
# EXPO_PUBLIC_DEV_UID=dev-rider

# ── Map tiles (location picker / job map) ─────────────────────────────────────
# Optional. Unset = keyless CARTO Voyager @2x tiles (the default, no signup).
# Force a source with EXPO_PUBLIC_MAP_TILE_PROVIDER=carto|osm|tomtom|maptiler|mapbox
# plus that source's key. With no provider set, a MapTiler/Mapbox key (if present)
# wins over CARTO; TomTom is only used when the provider is explicitly "tomtom".
# These ship IN the app bundle — use a separate, tiles-only key (TomTom: Map
# Display API only) and restrict it; never reuse the API's server TomTom key.
# EXPO_PUBLIC_MAP_TILE_PROVIDER=carto
# EXPO_PUBLIC_TOMTOM_MAP_KEY=
# EXPO_PUBLIC_MAPTILER_KEY=
# EXPO_PUBLIC_MAPBOX_TOKEN=

# ── EAS builds ────────────────────────────────────────────────────────────────
# .env is git-ignored, so EAS Build does NOT upload it. For store/dev-client
# builds set these same EXPO_PUBLIC_* vars in EAS (expo.dev → project →
# Environment variables, per environment). Store credentials (Apple / Google
# Play) are managed by `eas credentials`, not env vars.
